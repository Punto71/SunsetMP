<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SunsetMP.Controls"
             x:Class="SunsetMP.Pages.LocalPage"
             Title="Локальные">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,12" RowSpacing="10">

        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16,8">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Локальная музыка" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" />
                <controls:IconButton Grid.Column="1" ButtonSize="36" IconSize="16" Kind="Glass"
                                     IconData="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                     Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <!-- Поиск по локальным файлам -->
        <controls:SearchBox Grid.Row="1" Placeholder="Поиск по папкам и трекам" Text="{Binding SearchText, Mode=TwoWay}" />

        <VerticalStackLayout Grid.Row="2" Spacing="2">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Message}" FontSize="12" TextColor="#99FFFFFF" />
            <Label Text="Ничего не найдено" FontSize="13" TextColor="#99FFFFFF" IsVisible="{Binding NoResults}" />
            <Label Text="{Binding Status}" FontSize="13" TextColor="#4ade80" IsVisible="{Binding HasStatus}" />
        </VerticalStackLayout>

        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="6">
            <controls:TreeList x:Name="Tree" />
        </Border>
    </Grid>
</ContentPage>
