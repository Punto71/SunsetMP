{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // На каком адресе и порту слушает сервер. 0.0.0.0 — доступен из локальной сети.
  "Urls": "http://0.0.0.0:5080",

  "Library": {
    // Папка с музыкой. Windows: "D:\\Music", Linux: "/srv/music"
    "MusicPath": "/srv/music",

    // Отслеживать изменения в папке и обновлять библиотеку автоматически
    "WatchForChanges": true,

    // После запуска в фоне прочитать теги у всех файлов (быстрее открываются папки и точнее поиск)
    "WarmUpTags": true

    // Необязательно: свой список расширений (по умолчанию mp3, flac, m4a, aac, ogg, opus, wav, wma, ape, aiff)
    // "Extensions": [ ".mp3", ".flac" ]
  },

  "Auth": {
    // Единый токен для доступа к API. Его же вводят в приложении. ОБЯЗАТЕЛЬНО ЗАМЕНИТЕ.
    "Token": "1234"
  }
}
